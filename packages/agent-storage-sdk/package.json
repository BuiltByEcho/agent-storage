{
  "name": "@builtbyecho/agent-storage-sdk",
  "version": "0.1.3",
  "description": "TypeScript SDK for Vaultline — x402-native file storage for agents with typed errors and request timeouts",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "test": "node -e \"import('./dist/index.js').then(() => console.log('agent-storage-sdk import ok'))\"",
    "smoke": "npm test",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "vaultline",
    "agent-storage",
    "x402",
    "sdk",
    "base",
    "usdc",
    "agents",
    "storage"
  ],
  "author": "BuiltByEcho",
  "license": "MIT",
  "homepage": "https://builtbyecho.xyz/#vaultline",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuiltByEcho/vaultline.git",
    "directory": "packages/agent-storage-sdk"
  },
  "bugs": {
    "url": "https://github.com/BuiltByEcho/agent-storage/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@x402/core": "^2.11.0",
    "@x402/evm": "^2.11.0",
    "viem": "^2.28.0"
  },
  "overrides": {
    "ws": "^8.21.0",
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
