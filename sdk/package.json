{
  "name": "@builtbyecho/agent-storage-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for AgentStorage — x402-native file storage for agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "keywords": [
    "agent-storage",
    "x402",
    "sdk",
    "base",
    "usdc",
    "agents",
    "storage"
  ],
  "author": "BuiltByEcho",
  "license": "MIT",
  "homepage": "https://github.com/BuiltByEcho/agent-storage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuiltByEcho/agent-storage.git"
  },
  "bugs": {
    "url": "https://github.com/BuiltByEcho/agent-storage/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@x402/core": "^2.11.0",
    "@x402/evm": "^2.11.0",
    "viem": "^2.28.0"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
