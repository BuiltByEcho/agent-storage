{
  "name": "@builtbyecho/agent-storage",
  "version": "0.1.0",
  "description": "Vaultline \u2014 x402-native file storage for autonomous agents",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "check:x402": "tsx scripts-x402-check.ts",
    "check:x402:facilitator": "tsx scripts-x402-facilitator-check.ts",
    "check:x402:paid": "tsx scripts-x402-paid-local.ts",
    "check:x402:smoke": "tsx scripts-x402-smoke.ts",
    "docker:build": "docker build -t agent-storage ."
  },
  "keywords": [
    "x402",
    "agent-storage",
    "dropbox-for-agents",
    "usdc",
    "base"
  ],
  "author": "BuiltByEcho",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@coinbase/cdp-sdk": "^1.49.0",
    "@x402/core": "^2.11.0",
    "@x402/evm": "^2.11.0",
    "@x402/express": "^2.11.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "uuid": "^11.1.0",
    "viem": "^2.28.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "axios": "^1.16.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BuiltByEcho/agent-storage.git"
  },
  "homepage": "https://builtbyecho.xyz/#vaultline",
  "bugs": {
    "url": "https://github.com/BuiltByEcho/agent-storage/issues"
  }
}
