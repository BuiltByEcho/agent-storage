# Environment Configuration
# Copy to .env and fill in values

# Server
PORT=3001
NODE_ENV=development

# Cloudflare R2 (Primary Storage)
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=vaultline

# Backblaze B2 (Fallback Storage)
B2_APPLICATION_KEY_ID=your_key_id
B2_APPLICATION_KEY=your_key
B2_BUCKET_NAME=vaultline

# Usage metering
# Recommended in production. Vaultline auto-creates vaultline_usage_events.
NEON_DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Local fallback when NEON_DATABASE_URL / DATABASE_URL / POSTGRES_URL is unset.
VAULTLINE_USAGE_LEDGER_PATH=state/vaultline-usage-events.jsonl


# Client / smoke-test configuration
VAULTLINE_URL=https://storage.builtbyecho.xyz
# Fund this wallet with a little Base USDC before running production smoke tests.
VAULTLINE_PAYER_PRIVATE_KEY=0x...
# Required in production for expiring share-link tokens. Generate with: openssl rand -base64 32
VAULTLINE_SHARE_SECRET=***

# Bankr x402 Cloud proxy.
# Same secret must be set in Bankr with:
# bankr x402 env set VAULTLINE_BANKR_PROXY_TOKEN=...
BANKR_PROXY_TOKEN=***

# x402 Payment Configuration
X402_NETWORK=base
X402_USDC_CONTRACT=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_TREASURY_WALLET=your_treasury_wallet_address
# Mainnet requires authenticated CDP facilitator access
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=your_cdp_api_key_id
CDP_API_KEY_SECRET=your_cdp_api_key_secret

# Pricing (USD per GB)
# Open tier
PRICE_STORAGE_PER_GB_MONTH=0.08
PRICE_RETRIEVAL_PER_GB=0.015
PRICE_WRITE_PER_GB=0.03
# Private tier
PRICE_PRIVATE_STORAGE_PER_GB_MONTH=0.12
PRICE_PRIVATE_RETRIEVAL_PER_GB=0.02
PRICE_PRIVATE_WRITE_PER_GB=0.045
FREE_READ_MAX_BYTES=1048576

# Optional public hardening
REQUEST_BODY_LIMIT=100mb
# Comma-separated allowed browser origins, or * for public API/browser demos.
CORS_ORIGINS=*
